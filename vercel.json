{
  "version": 2,
  "rewrites": [
    { "source": "/student", "destination": "/student.html" },
    { "source": "/view/:token*", "destination": "/view.html" },
    { "source": "/q/:token*", "destination": "/questions.html" },
    { "source": "/api/(.*)", "destination": "/api/index.js?_url=$1" }
  ]
}
